# 两个 QQ 机器人各自的 AppID / AppSecret（QQ 开放平台）
SNOW_QQ_APP_ID=
SNOW_QQ_APP_SECRET=
CHAIFEN_QQ_APP_ID=
CHAIFEN_QQ_APP_SECRET=

# snow-xiaoyu 单字字形机器人（不需要模型 API Key）
XIAOYU_QQ_APP_ID=
XIAOYU_QQ_APP_SECRET=

# 冰雪大鱼和拆分大鱼共用的 DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 可选：默认直接联网。代理必须能从 Docker 容器访问。
# DAYU_PROXY=http://host.docker.internal:7897
TZ=Asia/Shanghai
