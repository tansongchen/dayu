# 两个 QQ 机器人各自的 AppID / AppSecret（QQ 开放平台）
SNOW_QQ_APP_ID=
SNOW_QQ_APP_SECRET=
CHAIFEN_QQ_APP_ID=
CHAIFEN_QQ_APP_SECRET=

# 支持工具调用的模型。按你的模型服务填写 Key、地址和模型名称。
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-6-sol
# Responses API 使用 openai-responses；Chat Completions 使用 openai-completions。
LLM_API=openai-responses

# 可选：默认直接联网。代理必须能从 Docker 容器访问。
# DAYU_PROXY=http://host.docker.internal:7897
TZ=Asia/Shanghai
